# Wiki 上游完整克隆、社区语料与本机运行数据
tools/repos/
tools/wiki-runtime/
tools/corpus/
# Gap observations contain readers' questions and are regenerated on demand.
/wiki/_gaps.json
# Nightly jobs, model transcripts and review receipts are local operational data.
/wiki/_jobs/*
!/wiki/_jobs/parameter-sync/
/wiki/_jobs/parameter-sync/published/
# Reports from the same jobs stay alongside their local receipts.
/wiki/warnings/drift-*
/wiki/warnings/params-*
/wiki/warnings/patrol-*
/wiki/warnings/reconcile-*
/wiki/warnings/_archived-pre-v030/
# Reproducible local parameter scan/review output (fixed inputs remain in seeds).
wiki/lineage/params-*.json

# 本机覆盖的同步配置（解释器路径等），见 scripts/wiki/sync.ts 的 readSyncConfig
wiki/sync.config.local.json
