+
+    def stub(name, **attrs):
+        module = ModuleType(name)
+        module.__dict__.update(attrs)
+        monkeypatch.setitem(sys.modules, name, module)
+        return module
+
+    def load(name):
+        full_name = f"{prefix}.{name}"
+        spec = importlib.util.spec_from_file_location(full_name, root / f"{name}.py")
